# Runtime storage (originals / work / outputs) — never committed.
data/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Agent-controlling config — kept local (not committed by team choice)
CLAUDE.md

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor atomic-write leftovers (e.g. `foo.py.tmp.PID.HASH`).
# Some editors do a "write to .tmp.* then rename" save; if the rename is
# interrupted (or the user opens two editors on the same file), the
# leftover survives. These files have also been seen to confuse the AGPL
# seam grep (a stale `pdf_engine.py.tmp.*` keeps an extra `import fitz`).
*.tmp.*

# GSD transient lock files (workflow concurrency guards).
.planning/*.lock

# Root-level debug / forensic scratch — never commit at repo root.
# Added 2026-05-27 after milestone v1.0 hotfix 06 cleanup (72 stray files
# accumulated during dCt-residue investigation). If a scratch file has
# historical/forensic value, archive it under
# `.planning/debug/scratch/<session>/` instead of leaving it at root.
# Patterns are /-anchored so .planning/debug/scratch/** remains tracked.
#
# Underscore-prefixed scratch (e.g. _verify_*.py, _compare_orig.pdf):
/_*.py
/_*.pdf
/_*.png
# Attack / repro / pre-post comparison images:
/attack_*.png
/today_attack_*.png
/verify_today_*.png
/cmp_*.png
/crop_*.png
/q_[A-Z]_*.png
/r_*.png
/proof_*.png
/shape_*.png
/z_*.png
# Render / hires snapshots:
/*_render.png
/*_hires.png
/orig_hires.png
/swap_hires.png
# Stray LogoSwap output PDFs accidentally saved to root:
/*_logoswap*.pdf

# v1.1 Phase 6 — Raw supplier PDF guards (Plan 06-01 / D-A4).
# Raw supplier PDFs(含原供應商商標 + metadata IP)must never be committed.
# Sanitized fixtures live in tests/fixtures/cad-glyph/ and ARE committed
# (D-A2 例外,README.md 文件化)。
#
# Root-anchored:repo root 已有的 3013A-... raw file 屏蔽防誤 commit
/3013A-13A-C6-XX-*.pdf
# samples/-anchored:tracked 副本 Plan 06-02 Task 4 將用 git rm 移除;
# 此 pattern 防止移除後又被 git add 回來
/samples/3013A-*.pdf
# Archived scratch dir(Plan 06-02 Task 4 物理 mv raw supplier PDF 至此處,
# .gitignore 確保移入後不被 git track,讓 git rm + 物理 mv 為兩步乾淨操作):
/.planning/debug/scratch/illustrator-attack-2026-05-28-archived/3013A-*.pdf
# Future-proof convention:任何 *-supplier-raw.pdf 命名的 raw file 都屏蔽
*-supplier-raw.pdf
