# Runtime storage (originals / work / outputs) — never committed.
data/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Agent-controlling config — kept local (not committed by team choice)
CLAUDE.md

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor atomic-write leftovers (e.g. `foo.py.tmp.PID.HASH`).
# Some editors do a "write to .tmp.* then rename" save; if the rename is
# interrupted (or the user opens two editors on the same file), the
# leftover survives. These files have also been seen to confuse the AGPL
# seam grep (a stale `pdf_engine.py.tmp.*` keeps an extra `import fitz`).
*.tmp.*
